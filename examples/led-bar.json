{
  "version": 1,
  "notes": [
    {
      "id": "note-title",
      "at": { "x": 0, "y": -150 },
      "text": "LED BAR GRAPH\n\nImport, then press Run.\n\nWorks with the default Blink sketch - no code needed. D13 clocks the 74HC595, DS is tied high, so every rising edge shifts in a 1 and latches it. One more LED lights each second until all eight are on.",
      "color": "#fde68a"
    },
    {
      "id": "note-595",
      "at": { "x": 420, "y": 180 },
      "text": "74HC595\nDS tied to 5V\nSHCP + STCP <- D13\nOE tied to GND\nMR tied to 5V",
      "color": "#a7f3d0"
    },
    {
      "id": "note-rule",
      "at": { "x": 560, "y": 340 },
      "text": "Each output drives a 220 ohm resistor into an LED. All cathodes return to the GND rail.",
      "color": "#bfdbfe"
    }
  ],
  "parts": [
