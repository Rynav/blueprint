{
  "name": "blueprint",
  "private": true,
  "version": "0.13.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check": "bun run check:app && bun run check:netlist && bun run check:spice && bun run check:devices && bun run check:circuit && bun run check:digital && bun run check:input && bun run check:pwm && bun run check:display && bun run check:keypad && bun run check:servo && bun run check:sensor && bun run check:lcd && bun run check:editor && bun run check:control && bun run check:part-control && bun run check:input-edge && bun run check:replay && bun run check:sample && bun run check:compile && bun run check:avr && bun run check:e2e",
    "check:app": "bun scripts/check.tsx",
    "check:netlist": "bun scripts/netlist-check.ts",
    "check:spice": "bun scripts/spice-check.ts && bun scripts/spice-verify.ts",
    "check:devices": "bun scripts/devices-check.ts",
    "check:circuit": "bun scripts/circuit-check.ts",
    "check:digital": "bun scripts/digital-check.ts",
    "check:input": "bun scripts/input-check.ts",
    "check:pwm": "bun scripts/pwm-check.ts",
    "check:display": "bun scripts/display-check.ts",
    "check:keypad": "bun scripts/keypad-check.ts",
    "check:servo": "bun scripts/servo-check.ts",
    "check:sensor": "bun scripts/sensor-check.ts",
    "check:lcd": "bun scripts/lcd-check.ts",
    "check:editor": "bun scripts/editor-check.ts",
    "check:control": "bun scripts/control-check.ts",
    "check:part-control": "bun scripts/part-control-check.ts",
    "check:input-edge": "bun scripts/input-edge-check.ts",
    "check:replay": "bun scripts/frame-budget-check.ts",
    "check:sample": "bun scripts/sample-check.ts",
    "check:compile": "bun scripts/compile-check.ts",
    "check:avr": "bun scripts/avr-check.ts",
    "check:e2e": "bun scripts/e2e-check.ts",
    "preview": "vite preview",
    "changelog": "git-cliff -o CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased --strip all",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@horang-corp/avr-gcc-wasm": "^0.2.0",
    "avr8js": "^0.21.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "monaco-editor": "^0.57.0",
    "oxlint": "^1.81.0",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
