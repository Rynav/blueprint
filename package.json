{
  "name": "blueprint",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check": "bun run check:app && bun run check:netlist && bun run check:spice && bun run check:circuit && bun run check:compile && bun run check:avr && bun run check:e2e",
    "check:app": "bun scripts/check.tsx",
    "check:netlist": "bun scripts/netlist-check.ts",
    "check:spice": "bun scripts/spice-check.ts && bun scripts/spice-verify.ts",
    "check:circuit": "bun scripts/circuit-check.ts",
    "check:compile": "bun scripts/compile-check.ts",
    "check:avr": "bun scripts/avr-check.ts",
    "check:e2e": "bun scripts/e2e-check.ts",
    "preview": "vite preview",
    "changelog": "git-cliff -o CHANGELOG.md",
    "changelog:preview": "git-cliff --unreleased --strip all",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@horang-corp/avr-gcc-wasm": "^0.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "avr8js": "^0.21.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.5",
    "shadcn": "^4.22.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
